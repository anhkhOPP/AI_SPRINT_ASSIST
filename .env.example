# ============================================================
# AI Sprint Assistant - Environment Configuration
# Copy file này thành .env và điền thông tin thực tế
# ============================================================

# --- GOOGLE CHAT WEBHOOK ---
# Webhook URL của Google Chat Space/Room (nhóm của bạn)
# Lấy tại: Google Chat > Space > Manage webhooks
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...

# Webhook URL riêng cho các thông báo quan trọng (optional)
GOOGLE_CHAT_ALERT_WEBHOOK_URL=

# --- GOOGLE CHAT BOT (Interactive) ---
# Service Account JSON để bot có thể nhắn tin 2 chiều
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service_account.json

# ID của Space/Room Google Chat
GOOGLE_CHAT_SPACE_ID=spaces/XXXXXXXXXX

# --- INTERNAL WEBSITE SCRAPING ---
# URL trang web nội bộ quản lý logwork
INTERNAL_LOGWORK_URL=https://your-internal-site.company.com/logwork
# URL trang web nội bộ quản lý daily standup
INTERNAL_DAILY_URL=https://your-internal-site.company.com/daily

# Phương thức xác thực nội bộ: basic_auth | session_cookie | oauth2 | ldap
INTERNAL_AUTH_TYPE=session_cookie

# Basic Auth (nếu dùng basic_auth)
INTERNAL_USERNAME=your_username
INTERNAL_PASSWORD=your_password

# Cookie xác thực (nếu dùng session_cookie)
INTERNAL_SESSION_COOKIE=your_session_cookie_value
INTERNAL_COOKIE_NAME=JSESSIONID

# OAuth2 token (nếu dùng oauth2)
INTERNAL_OAUTH_TOKEN=

# --- TIMEZONE ---
TIMEZONE=Asia/Ho_Chi_Minh

# --- SPRINT CONFIGURATION ---
# Ngày bắt đầu sprint hiện tại (YYYY-MM-DD)
CURRENT_SPRINT_START=2024-01-01
# Số tuần mỗi sprint (thường là 2)
SPRINT_DURATION_WEEKS=2
# Tên sprint hiện tại
CURRENT_SPRINT_NAME=Sprint 1

# --- SCHEDULE CONFIGURATION ---
# Giờ họp daily (HH:MM, 24h)
DAILY_MEETING_TIME=09:10
# Giờ nhắc log work (HH:MM, 24h)
LOGWORK_REMINDER_TIME=17:30
# Giờ check log work hôm qua (HH:MM, 24h)
LOGWORK_CHECK_TIME=09:30
# Giờ check daily standup (HH:MM, 24h)
DAILY_CHECK_TIME=10:00

# --- BOT SERVER ---
BOT_SERVER_HOST=0.0.0.0
BOT_SERVER_PORT=5000
BOT_SECRET_TOKEN=your_secret_token_here

# --- DATABASE ---
# SQLite (mặc định) hoặc PostgreSQL
DATABASE_URL=sqlite:///./data/sprint_assistant.db

# --- TEAM MEMBERS ---
# Danh sách thành viên (tên:email, cách nhau bởi ;)
# VD: Nguyen Van A:nguyenvana@company.com;Tran Thi B:tranthib@company.com
TEAM_MEMBERS=

# --- NOTIFICATIONS ---
# Ngưỡng cảnh báo (số người chưa log work để gửi alert riêng)
ALERT_THRESHOLD=3
# Bật/tắt thông báo cuối tuần
ENABLE_WEEKEND_REMINDERS=false
