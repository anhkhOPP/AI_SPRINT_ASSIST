# ============================================================
# AI Sprint Assistant - Cấu hình môi trường
# Copy file này thành .env và điền thông tin thực tế
# ============================================================

# ----------------------------------------------------------
# GOOGLE CHAT - GROUP (nhắn vào nhóm chung)
# Lấy tại: Google Chat > Space nhóm > Apps & Integrations > Webhooks
# ----------------------------------------------------------
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...

# ----------------------------------------------------------
# GOOGLE CHAT - PM SPACE (nhắn riêng PM)
# Tạo 1 Space riêng chỉ có bạn, đặt tên "Sprint Bot - PM"
# Lấy webhook tương tự như group
# ----------------------------------------------------------
GOOGLE_CHAT_PM_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YYYY/messages?key=...

# ----------------------------------------------------------
# TRANG NỘI BỘ op_pm
# ----------------------------------------------------------
INTERNAL_BASE_URL=https://10.36.36.63:8618/op_pm

# Tài khoản đăng nhập (bot tự login, tự gia hạn session)
INTERNAL_USERNAME=anhkh
INTERNAL_PASSWORD=Ss8638903

# URL trang login (thường là /login hoặc /auth/login)
# Nếu không chắc, để trống - bot sẽ tự thử
INTERNAL_LOGIN_URL=https://10.36.36.63:8618/op_pm/login

# Tên các field trong form login (xem page source để biết)
INTERNAL_LOGIN_FIELD_USERNAME=Username
INTERNAL_LOGIN_FIELD_PASSWORD=Password

# URL Worklog (đã có filter Yesterday - cố định)
INTERNAL_WORKLOG_URL=https://10.36.36.63:8618/op_pm/Worklog?fav=28728b78-2be9-4e1e-82e8-6f93d340881a

# URL trang Scrum Meeting Notes (chứa toàn bộ Daily Meeting)
INTERNAL_DAILY_PARENT_URL=https://10.36.36.63:8618/op_pm/HtmlDocument/Detail/578820bf-9f24-4be0-b89d-ed33d367a65a

# ----------------------------------------------------------
# NGƯỠNG LOG WORK
# ----------------------------------------------------------
# Số giờ tối thiểu phải log mỗi ngày
LOGWORK_MIN_HOURS=7.5

# ----------------------------------------------------------
# LỊCH (múi giờ Việt Nam)
# ----------------------------------------------------------
TIMEZONE=Asia/Ho_Chi_Minh
DAILY_MEETING_TIME=09:10
LOGWORK_CHECK_TIME=09:30
DAILY_CHECK_TIME=10:00
LOGWORK_REMINDER_TIME=17:30
# Hỏi PM lịch Sprint Review (Thứ 5)
SPRINT_REVIEW_ASK_TIME=09:00
# Hỏi PM lịch Sprint Planning (Thứ 2)
SPRINT_PLANNING_ASK_TIME=09:00

# ----------------------------------------------------------
# THÔNG TIN SPRINT HIỆN TẠI
# ----------------------------------------------------------
CURRENT_SPRINT_NAME=Sprint 19
CURRENT_SPRINT_START=2026-05-13
SPRINT_DURATION_WEEKS=2

# ----------------------------------------------------------
# BOT SERVER (nhận reply từ Google Chat)
# ----------------------------------------------------------
BOT_SERVER_HOST=0.0.0.0
BOT_SERVER_PORT=5000
BOT_SECRET_TOKEN=your_secret_token_here

# ----------------------------------------------------------
# CẢNH BÁO
# ----------------------------------------------------------
# Số người chưa log work để gửi thêm cảnh báo riêng
ALERT_THRESHOLD=3
